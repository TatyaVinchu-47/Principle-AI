# ============================================================
# Principle AI — Environment Variables
# Copy to .env.local and fill in. Never commit real secrets.
# ============================================================

# --- Supabase (required) ---
# From Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI (optional for Phase 1) ---
# If unset, the app falls back to deterministic heuristic parsing/matching
# so the product remains fully functional for local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin access ---
# Comma-separated list of emails granted admin dashboard access (Phase 5).
ADMIN_EMAILS=

# --- Automation (n8n / approved providers) ---
# Shared secret for the machine-to-machine ingestion webhook
# (POST /api/webhooks/ingest, header x-ingest-secret). Leave empty to disable.
INGEST_WEBHOOK_SECRET=
